#version 450

#include "utils.glsl"

layout(local_size_x = 1, local_size_y = 1) in;

// layout(binding = 0) uniform sampler2D in_albedo;
// layout(binding = 1) uniform sampler2D in_depth;

layout(binding = 0) uniform Data {
    CloudData data;
};

uniform vec2 resolution;

layout(rgba8_snorm, binding = 0) writeonly uniform image2D out_texture;

#define M_PI 3.1415926535897932384626433832795

vec3 center = vec3(0.0, 0.0, 0.0);
float radius = 1.0;
vec3 background_color = vec3(0.5, 0.7, 0.8);

uniform vec3 up;
uniform vec3 direction;
uniform float fov;

layout(binding = 1) buffer PointLights {
    PointLight point_lights[];
};

vec3 getDirection() {
    vec3 tn = normalize(direction);
    vec3 bn = normalize(cross(direction, up));
    vec3 vn = cross(tn, bn);

    float gx = 0.001 * tan(fov / 2.0);
    float gy = ((resolution.y) / (resolution.x)) * gx;

    vec3 qx = bn * ((2 * gx) / (resolution.x));
    vec3 qy = vn * ((2 * gy) / (resolution.y));
    vec3 p1m = tn * 0.001 - bn * gx - vn * gy;

    vec3 pij = p1m + qx * gl_GlobalInvocationID.x + qy * (resolution.y - gl_GlobalInvocationID.y);
    return normalize(pij);
}

float rand(vec2 co) {
    return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
}

vec2 intersect(const vec3 ray_origin, const vec3 ray_direction) {
    vec3 ray_origin_c = ray_origin - center;
    float a = dot(ray_direction, ray_direction);
    float b = 2 * dot(ray_direction, ray_origin_c);
    float c = dot(ray_origin_c, ray_origin_c) - radius * radius;

    float delta = b * b - 4 * a * c;

    if (delta < 0) {
        return vec2(0.0, 0.0);
    }

    // Computing the square roots
    delta = sqrt(delta);
    float t0 = (-b + delta) / (2 * a);
    float t1 = (-b - delta) / (2 * a);

    if (t0 > t1)
    {
        float tmp = t0;
        t0 = t1;
        t1 = tmp;
    }

    // Handling if we are in the sphere
    return vec2(t0, t1);
}

// the Henyey-Greenstein phase function, to replace with the MIE function later on
float phase(const float g, const float cos_theta)
{
    float denom = 1 + g * g - 2 * g * cos_theta;
    return 1 / (4 * M_PI) * (1 - g * g) / (denom * sqrt(denom));
}

// TODO: REPLACE WITH MULTI LEVEL PERLIN
// This come from https://gist.github.com/patriciogonzalezvivo/670c22f3966e662d2f83
vec4 permute(vec4 x) {
    return mod(((x * 34.0) + 1.0) * x, 289.0);
}
vec4 taylorInvSqrt(vec4 r) {
    return 1.79284291400159 - 0.85373472095314 * r;
}
vec3 fade(vec3 t) {
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

float noise(vec3 P) {
    vec3 Pi0 = floor(P); // Integer part for indexing
    vec3 Pi1 = Pi0 + vec3(1.0); // Integer part + 1
    Pi0 = mod(Pi0, 289.0);
    Pi1 = mod(Pi1, 289.0);
    vec3 Pf0 = fract(P); // Fractional part for interpolation
    vec3 Pf1 = Pf0 - vec3(1.0); // Fractional part - 1.0
    vec4 ix = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
    vec4 iy = vec4(Pi0.yy, Pi1.yy);
    vec4 iz0 = Pi0.zzzz;
    vec4 iz1 = Pi1.zzzz;

    vec4 ixy = permute(permute(ix) + iy);
    vec4 ixy0 = permute(ixy + iz0);
    vec4 ixy1 = permute(ixy + iz1);

    vec4 gx0 = ixy0 / 7.0;
    vec4 gy0 = fract(floor(gx0) / 7.0) - 0.5;
    gx0 = fract(gx0);
    vec4 gz0 = vec4(0.5) - abs(gx0) - abs(gy0);
    vec4 sz0 = step(gz0, vec4(0.0));
    gx0 -= sz0 * (step(0.0, gx0) - 0.5);
    gy0 -= sz0 * (step(0.0, gy0) - 0.5);

    vec4 gx1 = ixy1 / 7.0;
    vec4 gy1 = fract(floor(gx1) / 7.0) - 0.5;
    gx1 = fract(gx1);
    vec4 gz1 = vec4(0.5) - abs(gx1) - abs(gy1);
    vec4 sz1 = step(gz1, vec4(0.0));
    gx1 -= sz1 * (step(0.0, gx1) - 0.5);
    gy1 -= sz1 * (step(0.0, gy1) - 0.5);

    vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
    vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
    vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
    vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
    vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
    vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
    vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
    vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);

    vec4 norm0 = taylorInvSqrt(vec4(dot(g000, g000), dot(g010, g010), dot(g100, g100), dot(g110, g110)));
    g000 *= norm0.x;
    g010 *= norm0.y;
    g100 *= norm0.z;
    g110 *= norm0.w;
    vec4 norm1 = taylorInvSqrt(vec4(dot(g001, g001), dot(g011, g011), dot(g101, g101), dot(g111, g111)));
    g001 *= norm1.x;
    g011 *= norm1.y;
    g101 *= norm1.z;
    g111 *= norm1.w;

    float n000 = dot(g000, Pf0);
    float n100 = dot(g100, vec3(Pf1.x, Pf0.yz));
    float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
    float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
    float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
    float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
    float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
    float n111 = dot(g111, Pf1);

    vec3 fade_xyz = fade(Pf0);
    vec4 n_z = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fade_xyz.z);
    vec2 n_yz = mix(n_z.xy, n_z.zw, fade_xyz.y);
    float n_xyz = mix(n_yz.x, n_yz.y, fade_xyz.x);
    return 2.2 * n_xyz;
}

float eval_density(const vec3 p)
{
    float freq = 1;
    return (1 + noise(p * freq)) * 0.5;
}

vec3 integrate(
    const vec3 ray_origin,
    const vec3 ray_direction,
    const vec2 t)
{
    float sigma_a = 0.5;
    float sigma_s = 0.5;
    float transparency = 1.0;
    vec3 res = vec3(0.0);
    float g = 0; // Asymmetry factor of the phase function
    float step_size = 0.2;

    int ns = int(ceil((t.y - t.x) / step_size));
    step_size = (t.y - t.x) / float(ns);

    // Main raymarching loop
    for (int n = 0; n < ns; n++) {
        // Remember: to avoid jittering, randomize the 0.5
        float t_p = t.x + step_size * (n + 0.5);
        vec3 sample_pos = ray_origin + ray_direction * t_p;

        float density = eval_density(sample_pos);
        float sample_attenuation = exp(-step_size * density * (sigma_a + sigma_s));
        transparency *= sample_attenuation;

        // Ray-march along the light ray, and store the density values in the tau variable.
        vec2 inter_light = intersect(sample_pos, normalize(point_lights[0].position - sample_pos));
        // Not certain about this line, must check it again
        if (density > 0 &&
                inter_light.x != 0 && inter_light.y != 0
        )
        {
            int num_steps_light = int(ceil(inter_light.y / step_size));
            float light_step_size = inter_light.y / num_steps_light;
            float tau = 0;
            for (int nl = 0; nl < num_steps_light; nl++)
            {
                float t_light = light_step_size * (nl * 0.5);
                vec3 light_sample_pos = sample_pos + point_lights[0].position * t_light;
                tau += eval_density(light_sample_pos);
            }
            float light_ray_att = exp(-tau * light_step_size * (sigma_a + sigma_s));
            float cos_theta = dot(ray_direction, point_lights[0].position);
            res += point_lights[0].color * light_ray_att * phase(g, cos_theta) * sigma_s * transparency * step_size * density;
        }

        if (transparency < 0.001)
            break;
    }
    return res + background_color * transparency;
}

void main() {
    vec3 ray_origin = data.camera.camera_pos;
    ivec2 coords = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y);
    vec2 tmp = vec2(coords.x, coords.y);
    vec2 uv = tmp / resolution;

    vec3 ray_direction = getDirection();
    vec2 t = intersect(ray_origin, ray_direction);

    if (t.x <= 0.0 && t.y <= 0)
        return;

    vec3 p1 = ray_origin + ray_direction * t.x;
    vec3 p2 = ray_origin + ray_direction * t.y;

    float travelled_distance = length(p1 - p2);

    vec3 color = integrate(ray_origin, ray_direction, t);

    color = vec3(clamp(color.r, 0.0, 1.0), clamp(color.g, 0.0, 1.0), clamp(color.b, 0.0, 1.0));

    imageStore(out_texture, coords, vec4(color, 1.0));
    return;
}
