double fade(double t) {
    return t * t * t * (t * (t * 6 - 15) + 10);
}
double grad(int hash, double x, double y, double z)
{
    int h = hash & 15;
    double u = h < 8 ? x : y,
    v = h < 4 ? y : h == 12 || h == 14 ? x : z;
    return ((h & 1) == 0 ? u : -u) + ((h & 2) == 0 ? v : -v);
}

float noise(vec3 pos)
{
    double x = pos.x;
    double y = pos.y;
    double z = pos.z;
    int X = int(floor(x)) & 255;
    int Y = int(floor(y)) & 255;
    int Z = int(floor(z)) & 255;
    x -= floor(x);
    y -= floor(y);
    z -= floor(z);
    double u = fade(x);
    double v = fade(y);
    double w = fade(z);
    int A = p[X] + Y, AA = p[A] + Z, AB = p[A + 1] + Z,
    B = p[X + 1] + Y, BA = p[B] + Z, BB = p[B + 1] + Z;

    return float(mix(mix(mix(grad(p[AA], x, y, z),
                    grad(p[BA], x - 1, y, z), u),
                mix(grad(p[AB], x, y - 1, z),
                    grad(p[BB], x - 1, y - 1, z), u), v),
            mix(mix(grad(p[AA + 1], x, y, z - 1),
                    grad(p[BA + 1], x - 1, y, z - 1), u),
                mix(grad(p[AB + 1], x, y - 1, z - 1),
                    grad(p[BB + 1], x - 1, y - 1, z - 1), u), v), w));
}

vec3 integrate(
    const vec3 ray_origin,
    const vec3 ray_direction,
    const vec2 t)
{
    float transparency = 1.0;
    vec3 res = vec3(0.0);

    float g = 0.8; // Asymmetry factor of the phase function

    float step_size = 0.2;

    int ns = int(ceil((t.y - t.x) / step_size));
    step_size = (t.y - t.x) / float(ns);

    for (int n = 0; n < ns; n++) {
        // Remember: to avoid kittering, randomize the 0.5
        float t_p = t.x + step_size * (n + 0.5);
        vec3 pos = ray_origin + ray_direction * t_p;
        float density = (1 + noise(normalize(pos))) / 2;
        vec2 inter_light = intersect(pos, normalize(point_lights[0].position - pos));

        float sample_attenuation = exp(-step_size * density * (sigma_a + sigma_s));

        transparency *= sample_attenuation;

        float light_attenuation = exp(-inter_light.y * (sigma_a + sigma_s));

        float cos_theta = dot(ray_direction, point_lights[0].position);
        res += transparency * point_lights[0].color * light_attenuation * sigma_s * phase(g, cos_theta) * step_size * density;

        if (transparency < 0.001)
            break;
    }
    return res + background_color * transparency;
}

void main() {
    vec3 ray_origin = data.camera.camera_pos;
    ivec2 coords = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y);
    vec2 tmp = vec2(coords.x, coords.y);
    vec2 uv = tmp / resolution;

    vec3 ray_direction = getDirection();
    vec2 t = intersect(ray_origin, ray_direction);

    if (t.x <= 0.0 && t.y <= 0)
        return;

    vec3 p1 = ray_origin + ray_direction * t.x;
    vec3 p2 = ray_origin + ray_direction * t.y;

    float travelled_distance = length(p1 - p2);
    float transmission = exp(-travelled_distance * sigma_a);

    vec3 color = integrate(ray_origin, ray_direction, t);

    color = vec3(clamp(color.r, 0.0, 1.0), clamp(color.g, 0.0, 1.0), clamp(color.b, 0.0, 1.0));

    imageStore(out_texture, coords, vec4(color, 1.0));
    return;
}
