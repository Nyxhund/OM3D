#version 450

#include "utils.glsl"

layout(local_size_x = 1, local_size_y = 1) in;

// layout(binding = 0) uniform sampler2D in_albedo;
// layout(binding = 1) uniform sampler2D in_depth;

layout(binding = 0) uniform Data {
    CloudData data;
};

uniform vec2 resolution;

layout(rgba8_snorm, binding = 0) writeonly uniform image2D out_texture;

vec3 center = vec3(2.0, 2.0, 2.0);
float radius = 1.0;
vec3 scatter = vec3(0.8, 0.1, 0.5);
float sigma_a = 0.1;
vec3 background_color = vec3(0.572, 0.772, 0.921);

uniform vec3 up;
uniform vec3 direction;
uniform float fov;

layout(binding = 1) buffer PointLights {
    PointLight point_lights[];
};

vec3 getDirection() {
    vec3 tn = normalize(direction);
    vec3 bn = normalize(cross(direction, up));
    vec3 vn = cross(tn, bn);

    float gx = 0.001 * tan(fov / 2.0);
    float gy = ((resolution.y) / (resolution.x)) * gx;

    vec3 qx = bn * ((2 * gx) / (resolution.x));
    vec3 qy = vn * ((2 * gy) / (resolution.y));
    vec3 p1m = tn * 0.001 - bn * gx - vn * gy;

    vec3 pij = p1m + qx * gl_GlobalInvocationID.x + qy * gl_GlobalInvocationID.y;
    return pij;
}

vec2 intersect(const vec3 ray_origin, const vec3 ray_direction) {
    vec3 ray_origin_c = ray_origin - center;
    float a = dot(ray_direction, ray_direction);
    float b = 2 * dot(ray_direction, ray_origin_c);
    float c = dot(ray_origin_c, ray_origin_c) - radius * radius;

    float delta = b * b - 4 * a * c;

    if (delta < 0) {
        return vec2(0.0, 0.0);
    }

    // Computing the square roots
    delta = sqrt(delta);
    float t0 = (-b + delta) / (2 * a);
    float t1 = (-b - delta) / (2 * a);

    if (t0 > t1)
    {
        float tmp = t0;
        t0 = t1;
        t1 = tmp;
    }

    // Handling if we are in the sphere
    return vec2(t0, t1);
}

vec3 integrate(const vec3 ray_origin, const vec3 ray_direction, const vec2 t)
{
    float transparency = 1.0;
    vec3 res = vec3(0.0);

    float step_size = 0.2;
    int ns = int(ceil((t.y - t.x) / step_size));
    step_size = (t.y - t.x) / ns;
    for (int n = 0; n < ns; n++) {
        float t_p = t.x + step_size * (n + 0.5);
        vec3 pos = ray_origin + ray_direction * t_p;
        vec2 inter_light = intersect(pos, point_lights[0].position - pos);
        vec3 li = exp(-inter_light.y * sigma_a) * step_size * point_lights[0].color;
        transparency *= exp(-step_size * sigma_a);
        res += li * transparency;
    }
    return res + background_color * transparency;
}

void main() {
    vec3 ray_origin = data.camera.camera_pos;
    ivec2 coords = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y);
    vec2 tmp = vec2(coords.x, coords.y);
    vec2 uv = tmp / resolution;

    vec3 ray_direction = getDirection();
    vec2 t = intersect(ray_origin, ray_direction);

    if (t.x == 0.0 && t.y == 0)
        return;

    vec3 p1 = ray_origin + ray_direction * t.x;
    vec3 p2 = ray_origin + ray_direction * t.y;

    float travelled_distance = length(p1 - p2);
    float transmission = exp(-travelled_distance * sigma_a);

    vec3 color = integrate(ray_origin, ray_direction, t);

    color = vec3(clamp(color.r, 0.0, 1.0), clamp(color.g, 0.0, 1.0), clamp(color.b, 0.0, 1.0));

    imageStore(out_texture, coords, vec4(color, 1.0));
    return;
}
